{
"version": "2.0.0",
"tasks": [
{
"label": "cmake-configure",
"type": "shell",
"command": "cmake",
"args": [
"-G", "Visual Studio 18 2026",
"-A", "Win32",
"-S", "${workspaceFolder}",
"-B", "${workspaceFolder}/build"
],
"options": {
"cwd": "${workspaceFolder}"
},
"problemMatcher": [],
"presentation": {
"reveal": "always"
}
},
{
"label": "cmake-build",
"type": "shell",
"command": "cmake",
"args": [
"--build", "${workspaceFolder}/build",
"--config", "Debug"
],
"options": {
"cwd": "${workspaceFolder}"
},
"problemMatcher": "$msCompile",
"presentation": {
"reveal": "always"
}
},
{
"label": "build-dll",
"dependsOn": ["cmake-configure", "cmake-build"],
"dependsOrder": "sequence",
"group": {
"kind": "build",
"isDefault": true
},
"problemMatcher": []
}
]
}
